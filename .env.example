# Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=

# Generate a separate value with: openssl rand -hex 32
# Keep this value stable or saved user API keys cannot be decrypted.
API_KEY_ENCRYPTION_SECRET=

# Grafana is published on host port 3001 so it does not conflict with the
# frontend's existing host port 3000. Change this only if 3001 is already used.
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin

# Generate with: openssl rand -base64 32
GRAFANA_ADMIN_PASSWORD=

# Optional: set deployable registry tags before `docker compose build` and
# `docker compose push`. Local Compose image names are used when omitted.
# BACKEND_IMAGE=registry.example.com/electromentor/backend:latest
# FRONTEND_IMAGE=registry.example.com/electromentor/frontend:latest
