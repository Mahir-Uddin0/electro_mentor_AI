NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
# Preview access is available only when this is true or Supabase is unconfigured.
NEXT_PUBLIC_USE_MOCK_API=true
# Conversation endpoints are implemented in FastAPI. Set true only to preview
# the chat-history UI without running the backend.
NEXT_PUBLIC_USE_MOCK_CHAT_API=false
# Photo analysis is implemented in FastAPI. Set true only for a local UI preview.
NEXT_PUBLIC_USE_MOCK_PHOTO_API=false
# Safety checklist PDFs are served by FastAPI. Set true only for a UI preview.
NEXT_PUBLIC_USE_MOCK_CHECKLIST_API=false
# Wiring/circuit guide PDFs are served by FastAPI.
NEXT_PUBLIC_USE_MOCK_GUIDE_API=false
# User tasks are stored through the authenticated FastAPI task endpoints.
NEXT_PUBLIC_USE_MOCK_TASK_API=false
