APP_NAME="ElectroMentor AI API"
ENVIRONMENT=development
DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

RETRIEVAL_TOP_K=4

# Supabase Auth, chat history, and task storage. The JWT secret is needed for legacy
# HS256 tokens; ES256/RS256 projects are verified through the public JWKS.
# Use the project's publishable/anon key for SUPABASE_API_KEY so user RLS applies.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_API_KEY=
# Server only. Use the project's sb_secret_ key (preferred) or legacy
# service_role JWT. Never expose this value in a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_CHAT_MESSAGES_TABLE=chat_messages
SUPABASE_TASKS_TABLE=tasks
SUPABASE_PRACTICAL_ASSESSMENTS_TABLE=practical_assessments
# Private Supabase Storage bucket for mandatory practical-work videos.
SUPABASE_PRACTICAL_ASSESSMENT_VIDEOS_BUCKET=practical-assessment-videos
# Prior messages from the selected conversation included in the Gemini prompt.
CHAT_HISTORY_MESSAGE_LIMIT=7
SUPABASE_REQUEST_TIMEOUT_SECONDS=10

# One Gemini Developer API key powers generation and all embedding operations.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.7-flash
# Transient 408/429/5xx failures fall back from left to right. The primary
# model is always tried first; models larger than the configured primary are skipped.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_GENERATION_MAX_OUTPUT_TOKENS=2048
# Attempts per model for timeouts and other transient failures. Capacity errors
# (429/503) move immediately to the next configured fallback model.
GEMINI_GENERATION_MAX_RETRIES=3
# Multimodal model used only for structured wiring-photo analysis.
GEMINI_VISION_MODEL=gemini-3.7-flash
GEMINI_VISION_MAX_OUTPUT_TOKENS=4096
# Raw bytes. This leaves room for base64 expansion inside Gemini's 20 MB request.
PHOTO_ANALYSIS_MAX_IMAGE_BYTES=14000000
# Dedicated multimodal model and limits for mandatory practical-work videos.
GEMINI_ASSESSMENT_MODEL=gemini-3.7-flash
GEMINI_ASSESSMENT_MAX_OUTPUT_TOKENS=8192
GEMINI_FILE_PROCESSING_TIMEOUT_SECONDS=180
# Must not exceed the matching 100 MB Postgres and Storage bucket limits.
PRACTICAL_ASSESSMENT_MAX_VIDEO_BYTES=100000000
# Separate timeout for large private Supabase Storage transfers. Ordinary
# PostgREST requests continue to use SUPABASE_REQUEST_TIMEOUT_SECONDS.
PRACTICAL_ASSESSMENT_STORAGE_TIMEOUT_SECONDS=300
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
# Conservative free-tier ingestion pacing. The default sends at most five
# requests/minute, spaces them roughly 12 seconds apart, and also enforces a
# conservative estimated input-token budget over every rolling minute.
GEMINI_EMBEDDING_BATCH_SIZE=5
GEMINI_EMBEDDING_REQUESTS_PER_MINUTE=5
GEMINI_EMBEDDING_TOKENS_PER_MINUTE=10000
GEMINI_EMBEDDING_MAX_RETRIES=8
GEMINI_EMBEDDING_RETRY_BASE_SECONDS=15
GEMINI_EMBEDDING_RETRY_MAX_SECONDS=120

# Persistent Chroma vector store
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=electromentor_documents

# Ingestion paths
RAW_PDF_DIRECTORY=data/raw_pdfs
MARKDOWN_DIRECTORY=data/markdown
CHUNKS_DIRECTORY=data/chunks
SAFETY_CHECKLIST_DIRECTORY=data/safety_checklist
GUIDE_LIBRARY_DIRECTORY=data/wiring_circuit_guide_library

# Semantic chunking
SEMANTIC_BREAKPOINT_PERCENTILE=80
SEMANTIC_CANDIDATE_CHARS=350
SEMANTIC_MIN_CHUNK_CHARS=800
SEMANTIC_MAX_CHUNK_CHARS=5000
